# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 现有代码统一 4 空格缩进
[*.java]
indent_style = space
indent_size = 4

# 构建与配置文件
[*.{xml,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.properties]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
